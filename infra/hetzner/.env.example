# Copie para infra/hetzner/.env no servidor (nunca no git). Preencha os valores vazios.

# Domínio apontado para o servidor (registro A). O Caddy tira o certificado sozinho.
BOT_DOMAIN=bot.c1imob.com.br

# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v26.0
# Opcional: token único para números sem token no Vault (decisão 6).
WHATSAPP_ACCESS_TOKEN=
# Opcional: token da Marketing API (ads_read) para contas de anúncios sem token no Vault (gasto da Meta).
META_ADS_ACCESS_TOKEN=

# Postgres do Supabase (conexão direta, papel com acesso de sistema). Formato:
# postgresql://USUARIO:SENHA@HOST:5432/postgres
DATABASE_URL=

# LLM (opcional). Sem a chave, o bot entende só botões e palavras-chave.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Alertas (opcional; os dois ou nenhum).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sentry do bot (opcional). Sem DSN, erros ficam só no log. Nada de dado pessoal é enviado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Leitor de PDF (contêiner ingest). Gere com: openssl rand -hex 24. O mesmo valor vai no web
# (INGEST_SECRET), junto com INGEST_URL=https://SEU_DOMINIO/ingest.
INGEST_SECRET=

# Backup verificado (contêiner backup). Conexão direta ao Postgres do Supabase, com permissão de leitura
# em public, drizzle e auth.users (o usuário postgres serve).
BACKUP_DATABASE_URL=
# Dias que as cópias ficam no servidor (LGPD: lead excluído some dos backups depois disso).
BACKUP_KEEP_DAYS=14
# Opcional: URL chamada a cada backup verificado (ex.: healthchecks.io), para saber se ele PAROU de rodar.
BACKUP_PING_URL=

LOG_LEVEL=info
