# Copie para infra/hetzner/.env no servidor (nunca no git). Preencha os valores vazios.

# Domínio apontado para o servidor (registro A). O Caddy tira o certificado sozinho.
BOT_DOMAIN=bot.c1imob.com.br

# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v26.0
# Opcional: token único para números sem token no Vault (decisão 6).
WHATSAPP_ACCESS_TOKEN=

# Postgres do Supabase (conexão direta, papel com acesso de sistema). Formato:
# postgresql://USUARIO:SENHA@HOST:5432/postgres
DATABASE_URL=

# LLM (opcional). Sem a chave, o bot entende só botões e palavras-chave.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Alertas (opcional; os dois ou nenhum).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=info
