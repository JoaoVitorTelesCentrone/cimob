# Copie para .env. Nunca faça commit de segredos.
# O bot tem o próprio exemplo: apps/bot/.env.example.

# Supabase local (pnpm db:start). Portas 64xxx para não conflitar com outros projetos.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:64322/postgres

# Web (apps/web/.env.local). A chave publicável é pública; a service role NUNCA vai para o web.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:64321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<rode `pnpm db:start` e copie PUBLISHABLE_KEY>

# E2E (pnpm test:e2e). Não precisa definir: o Playwright lê do Supabase local (`supabase status`),
# tanto na máquina quanto no CI. Só o processo de teste usa a chave secreta; ela nunca vai para o app.
# SUPABASE_SECRET_KEY=

# Sentry do web (opcional). Servidor: SENTRY_DSN; navegador: NEXT_PUBLIC_SENTRY_DSN (o DSN é público por natureza).
# Sem eles, o Sentry não liga. Nada de dado pessoal é enviado (ver packages/core/src/scrub.ts).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
