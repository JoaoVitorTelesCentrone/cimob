# Bot de WhatsApp (apps/bot). Copie para .env. Nunca faça commit de segredos.

# Token que você inventa e cadastra no painel da Meta (verificação do webhook).
WHATSAPP_VERIFY_TOKEN=
# App Secret do app da Meta (Configurações do app > Básico). Assina o corpo de cada POST.
WHATSAPP_APP_SECRET=
# Redis das filas (BullMQ). No Docker Compose do Hetzner: redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379
PORT=8787
LOG_LEVEL=info
# Postgres do Supabase (conexão direta; o bot grava como sistema e sempre filtra por organização).
# Local: postgresql://postgres:postgres@127.0.0.1:64322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:64322/postgres

# Envio pela Cloud API (worker outbound).
GRAPH_API_VERSION=v26.0
# Token único da Cloud API para números sem token no Supabase Vault (opcional; ver decisão 6).
WHATSAPP_ACCESS_TOKEN=
# Token da Marketing API (ads_read) para contas de anúncios sem token no Vault (opcional; gasto da Meta).
META_ADS_ACCESS_TOKEN=
# Alertas da operação no Telegram (opcional; as duas ou nenhuma). Sem elas, o alerta vai só para o log.
# Sentry (opcional): DSN do projeto do bot. Sem ele, erros ficam só no log. Nada de dado pessoal é enviado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Extração com LLM (OpenRouter). Sem a chave, o bot entende só botões e palavras-chave.
OPENROUTER_API_KEY=
# Opcional. Padrão: deepseek/deepseek-v4.1-flash
OPENROUTER_MODEL=
